{
    "name": "ccreward-web",
    "main": ".open-next/worker.js",
    "compatibility_date": "2026-01-01",
    "compatibility_flags": [
        "nodejs_compat"
    ],
    "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
    },
    "observability": {
        "logs": {
            "enabled": true,
            "head_sampling_rate": 1,
            "invocation_logs": true,
            "persist": true
        }
    },
    "env": {
        "dev": {
            "name": "ccreward-web-dev",
            "routes": [
                {
                    "pattern": "dev.ccreward.app",
                    "custom_domain": true
                }
            ],
            "kv_namespaces": [
                {
                    "binding": "NEXT_CACHE_WORKERS_KV",
                    "id": "fa2bcf379a1741f5bfb33323e8cdafad"
                }
            ]
        },
        "prod": {
            "name": "ccreward-web-prod",
            "routes": [
                {
                    "pattern": "ccreward.app",
                    "custom_domain": true
                }
            ],
            "kv_namespaces": [
                {
                    "binding": "NEXT_CACHE_WORKERS_KV",
                    "id": "0507c6cedd314f108fbf29f84212f141"
                }
            ]
        }
    }
}