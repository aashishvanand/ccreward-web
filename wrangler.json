{
    "name": "ccreward-web",
    "main": ".open-next/worker.js",
    "compatibility_date": "2026-01-01",
    "compatibility_flags": [
        "nodejs_compat"
    ],
    "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
    },
    "images": {
        "binding": "IMAGES"
    },
    "observability": {
        "logs": {
            "enabled": true,
            "head_sampling_rate": 1,
            "invocation_logs": true,
            "persist": true
        }
    },
    "env": {
        "dev": {
            "name": "ccreward-web-dev",
            "routes": [
                {
                    "pattern": "dev.ccreward.app",
                    "custom_domain": true
                }
            ],
            "kv_namespaces": [
                {
                    "binding": "NEXT_CACHE_WORKERS_KV",
                    "id": "fa2bcf379a1741f5bfb33323e8cdafad"
                }
            ],
            "r2_buckets": [
                {
                    "binding": "NEXT_INC_CACHE_R2_BUCKET",
                    "bucket_name": "ccreward-next-cache-dev"
                }
            ]
        },
        "prod": {
            "name": "ccreward-web-prod",
            "routes": [
                {
                    "pattern": "ccreward.app",
                    "custom_domain": true
                }
            ],
            "kv_namespaces": [
                {
                    "binding": "NEXT_CACHE_WORKERS_KV",
                    "id": "0507c6cedd314f108fbf29f84212f141"
                }
            ],
            "r2_buckets": [
                {
                    "binding": "NEXT_INC_CACHE_R2_BUCKET",
                    "bucket_name": "ccreward-next-cache-prod"
                }
            ]
        }
    },
    "services": [
        {
            "binding": "WORKER_SELF_REFERENCE",
            "service": "ccreward-web"
        }
    ]
}