# Cloudflare static-asset headers. These apply only to files served from
# dist/client (turnstile.html, /scripts/*, images); pages rendered by the
# Worker get their headers from next.config.mjs. Both use security-headers.mjs.

# Allow access to OG image from any origin
/og.png
  Access-Control-Allow-Origin: *

# Allow access to Logo image from any origin
/ccreward_dark.png
  Access-Control-Allow-Origin: *

/ccreward_light.png
  Access-Control-Allow-Origin: *

# Allow access to app-ads.txt and ads.txt
/app-ads.txt
  Content-Type: text/plain
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0
  Access-Control-Allow-Origin: *
  X-Robots-Tag: all

/ads.txt
  Content-Type: text/plain
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0
  Access-Control-Allow-Origin: *
  X-Robots-Tag: all

# Allow access to security.txt
/security.txt
  Content-Type: text/plain
  Cache-Control: no-cache
  Access-Control-Allow-Origin: *
  X-Robots-Tag: all

# Apple App Site Association
/.well-known/apple-app-site-association
  Content-Type: application/json

# Keep the development domain out of search and caches
https://dev.ccreward.app/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store, no-cache, must-revalidate

# Unhashed static files: cache for a day, revalidate in the background for a week
/scripts/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/*.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

# Hashed build output
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

