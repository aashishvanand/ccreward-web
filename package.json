    "deploy:prod": "npm run build:worker && wrangler deploy --env prod",
    "start": "next start",
    "postinstall": "npm install --include=optional sharp --legacy-peer-deps",
    "analyze": "cross-env ANALYZE=true npm run build",
    "test:analytics": "node scripts/test-analytics.js"
  },
