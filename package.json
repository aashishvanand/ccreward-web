{
  "name": "ccreward.app",
  "version": "1.0.0",
  "private": true,
  "description": "A comprehensive tool to calculate and optimize credit card rewards across multiple banks in India & Singapore",
  "author": "Aashish Vivekanand",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/aashishvanand/ccreward-web.git"
  },
  "homepage": "https://ccreward.app",
  "bugs": {
    "url": "https://github.com/aashishvanand/ccreward-web/issues"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "fetch-data": "node scripts/fetch-static-data.js",
    "build": "npm run fetch-data && next build && npm run generate:sitemap",
    "build:worker": "opennextjs-cloudflare build",
    "preview": "npm run build:worker && wrangler dev",
    "deploy:dev": "npm run build:worker && wrangler deploy --env dev",
    "deploy:prod": "npm run build:worker && wrangler deploy --env prod",
    "start": "next start",
    "postinstall": "npm install --include=optional sharp --legacy-peer-deps",
    "analyze": "cross-env ANALYZE=true npm run build",
    "test:analytics": "node scripts/test-analytics.js",
    "generate:sitemap": "node scripts/generate-sitemap.js"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@microsoft/clarity": "^1.0.2",
    "@mui/icons-material": "^7.3.8",
    "@mui/material": "^7.3.8",
    "@mui/material-nextjs": "^7.3.8",
    "@opennextjs/cloudflare": "^1.16.5",
    "axios": "^1.13.5",
    "axios-retry": "^4.5.0",
    "firebase": "^12.9.0",
    "framer-motion": "^12.34.3",
    "jwt-decode": "^4.0.0",
    "lodash": "^4.17.23",
    "next": "^16.1.6",
    "prop-types": "^15.8.1",
    "react": "^19.2.4",
    "react-confetti": "^6.4.0",
    "react-dom": "^19.2.4",
    "react-share": "^5.2.2",
    "react-tweet": "^3.3.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.1.6",
    "@types/react": "^19.2.14",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.3",
    "eslint-config-next": "^16.1.6",
    "jest": "^30.2.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.67.0"
  },
  "resolutions": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "engines": {
    "node": ">=18.18.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "credit card reward calculator",
    "credit card rewards India",
    "credit card rewards Singapore",
    "best credit card rewards",
    "Indian credit card comparison",
    "Singapore credit card comparison",
    "credit card points calculator",
    "cashback calculator India",
    "cashback calculator Singapore",
    "credit card benefits India",
    "credit card benefits Singapore",
    "best credit cards in India",
    "best credit cards in Singapore",
    "reward point redemption",
    "credit card optimizer",
    "Indian banking rewards",
    "Singapore banking rewards",
    "financial tools India",
    "financial tools Singapore",
    "credit card miles calculator",
    "Indian credit card analysis",
    "Singapore credit card analysis",
    "maximize credit card benefits",
    "Indian personal finance",
    "Singapore personal finance",
    "credit card reward tracking",
    "credit card rewards app",
    "ccgeeks",
    "ccreward app"
  ],
  "overrides": {
    "@isaacs/brace-expansion": "^5.0.1",
    "fast-xml-parser": "^5.3.6",
    "qs": "^6.14.2",
    "@smithy/config-resolver": "^4.4.0"
  }
}