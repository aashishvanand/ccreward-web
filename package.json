{
  "name": "ccreward.app",
  "version": "1.1.0",
  "private": true,
  "description": "A comprehensive tool to calculate and optimize credit card rewards across multiple banks in India & Singapore",
  "author": "Aashish Vivekanand",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/aashishvanand/ccreward-web.git"
  },
  "homepage": "https://ccreward.app",
  "bugs": {
    "url": "https://github.com/aashishvanand/ccreward-web/issues"
  },
  "scripts": {
    "dev": "vinext dev",
    "fetch-data": "node scripts/fetch-static-data.js",
    "generate:sitemap": "node scripts/generate-sitemap.js",
    "prebuild:site": "npm run fetch-data && npm run generate:sitemap",
    "build": "npm run prebuild:site && vinext build",
    "start": "vinext start",
    "preview": "vinext-cloudflare deploy --preview",
    "clean:wrangler-deploy": "rm -rf .wrangler/deploy",
    "deploy:dev": "npm run clean:wrangler-deploy && npm run prebuild:site && vinext-cloudflare deploy --env dev",
    "deploy:prod": "npm run clean:wrangler-deploy && npm run prebuild:site && vinext-cloudflare deploy --env prod",
    "postinstall": "npm install --include=optional sharp --legacy-peer-deps",
    "analyze": "cross-env ANALYZE=true npm run build",
    "test:analytics": "node scripts/test-analytics.cjs"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@microsoft/clarity": "^1.0.2",
    "@mui/icons-material": "^9.3.1",
    "@mui/material": "^9.3.1",
    "@mui/material-nextjs": "^9.3.0",
    "axios": "^1.19.0",
    "axios-retry": "^4.5.0",
    "firebase": "^12.17.1",
    "framer-motion": "^13.0.0",
    "jwt-decode": "^4.0.0",
    "lodash": "^4.18.1",
    "next": "^16.3.0",
    "prop-types": "^15.8.1",
    "react": "^19.2.8",
    "react-confetti": "^6.4.0",
    "react-dom": "^19.2.8",
    "react-share": "^5.3.0",
    "react-tweet": "^3.3.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.51.0",
    "@cloudflare/workers-types": "^5.20260804.1",
    "@next/bundle-analyzer": "^16.3.0",
    "@types/react": "^19.2.18",
    "@vinext/cloudflare": "^1.0.0-beta.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitejs/plugin-rsc": "^0.5.33",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.0",
    "eslint-config-next": "^16.3.0",
    "glob": "^13.0.6",
    "jest": "^30.4.2",
    "react-server-dom-webpack": "^19.2.8",
    "typescript": "^7.0.2",
    "vinext": "^1.0.0-beta.4",
    "vite": "^8.2.1",
    "wrangler": "^4.119.0"
  },
  "resolutions": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "websocket-driver": "^0.7.5",
    "sharp": "^0.35.3",
    "protobufjs": "^7.6.5"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "keywords": [
    "credit card reward calculator",
    "credit card rewards India",
    "credit card rewards Singapore",
    "best credit card rewards",
    "Indian credit card comparison",
    "Singapore credit card comparison",
    "credit card points calculator",
    "cashback calculator India",
    "cashback calculator Singapore",
